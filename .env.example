# Copy this file to .env and fill in real values: `cp .env.example .env`
# .env itself is gitignored - never commit it. This file (.env.example) is
# the safe, committed template. See GUIDE.md for the full explanation.

POSTGRES_USER=app_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=app_db
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# POSTGRES_HOST / OLLAMA_HOST - the single most common bug in this whole
# stack. Ask yourself ONE question before setting these: is the code about
# to run ON MY MACHINE DIRECTLY, or IS A DOCKER CONTAINER RUNNING IT?
#
#   - Running `python some_script.py` yourself, in your own terminal
#     (native)              -> use `localhost`
#   - Code running automatically inside a container, e.g. via
#     `docker-compose up`   -> use the sibling container's SERVICE NAME
#     (e.g. `postgres`) to reach another container, or `host.docker.internal`
#     to reach something running on your host machine (like a local Ollama).
#
# "localhost" inside a container always means that container itself - never
# a sibling container, never your host machine.
#
# Defaults below assume you're running the full stack via `docker-compose up`.
# Swap both to `localhost` temporarily if you're running a script natively.
# ---------------------------------------------------------------------------
POSTGRES_HOST=postgres

OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2
# ANTHROPIC_API_KEY=
