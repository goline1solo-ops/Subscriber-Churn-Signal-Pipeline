POSTGRES_USER=churn_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=churn_signal
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Choose one AI backend for the churn-scoring step
# Ollama runs natively on Windows (not in a container) — host.docker.internal
# lets containers reach services running on your host machine.
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=llama3
