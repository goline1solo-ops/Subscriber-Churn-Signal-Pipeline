POSTGRES_USER=churn_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=churn_signal
# Defaults below (POSTGRES_HOST=postgres, OLLAMA_HOST=host.docker.internal)
# are correct for running the full stack via `docker-compose up`.
# If running extract_load.py natively instead (python extract_load.py),
# temporarily swap both to `localhost` - "localhost" inside a container
# means the container itself, not your Windows host or sibling containers.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2
# ANTHROPIC_API_KEY=
